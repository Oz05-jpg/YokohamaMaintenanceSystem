@using YokohamaMaintenanceSystem.Enums
@model YokohamaMaintenanceSystem.Models.PagedRequestViewModel
@{
    ViewData["Title"] = "Maintenance Requests";
}

<div class="yms-header">
    <h2>🛠️ Maintenance Requests</h2>
    <a asp-action="Create" class="btn btn-yms">+ New Request</a>
</div>

<form method="get" asp-action="Index" class="mb-3 d-flex gap-2" autocomplete="off">
    <input type="text" name="keyword" value="@Model.Keyword"
           class="form-control" placeholder="ค้นหา Title หรือ Description..." />
    <select name="status" class="form-select" style="width:200px" onchange="this.form.submit()">
            <option value="">All Status</option>
        @foreach (var s in Enum.GetValues(typeof(RequestStatus)))
        {
            if (Model.SelectStatus?.ToString() == s.ToString())
            {
                <option value="@s" selected>@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
    <button type="submit" class="btn btn-yms">Filter</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
</form>

@if (!Model.Requests.Any())
{
    <div class="text-center py-5 text-muted">
        <p style="font-size:1.1rem">ไม่พบคำขอซ่อม</p>
        <a asp-action="Create" class="btn btn-yms mt-2">+ สร้างคำขอแรก</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table yms-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Completed</th>
                    <th>Machine</th>
                    <th>Technician</th>
                    <th style="width:180px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Requests)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Description</td>
                        <td>@item.Priority</td>
                        <td>
                            @if (item.Status == RequestStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (item.Status == RequestStatus.InProgress)
                            {
                                <span class="badge bg-primary">In Progress</span>
                            }
                            else if (item.Status == RequestStatus.Completed)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                        </td>
                        <td>@item.CreatedAt</td>
                        <td>@item.CompletedAt</td>
                        <td>@item.Machine?.Name</td>
                        <td>@(item.Technician?.FullName ?? "ยังไม่ assign")</td>
                        <td class="d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="d-flex gap-2 mt-3">
    @if (Model.CurrentPage > 1)
    {
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.CurrentPage - 1)"
           asp-route-keyword="@Model.Keyword"
           asp-route-status="@Model.SelectStatus"
           class="btn btn-outline-secondary">← Previous</a>
    }
    <span class="align-self-center">หน้า @Model.CurrentPage</span>
    @if (Model.HasNextPage)
    {
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.CurrentPage + 1)"
           asp-route-keyword="@Model.Keyword"
           asp-route-status="@Model.SelectStatus"
           class="btn btn-outline-primary">Next →</a>
    }
</div>
<script>
    const params = new URLSearchParams(window.location.search);
    document.querySelector('select[name="status"]').value = params.get('status') || '';
</script>
