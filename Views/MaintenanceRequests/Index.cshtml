@using YokohamaMaintenanceSystem.Enums
@model IEnumerable<YokohamaMaintenanceSystem.Models.MaintenanceRequest>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<form method="get" asp-action="Index" class="mb-3 d-flex gap-2" autocomplete="off">
    <input type="text" name="keyword" value="@ViewBag.Keyword"
           class="form-control" placeholder="ค้นหา Title หรือ Description..." />
    <select name="status" class="form-select" style="width:200px" onchange="this.form.submit()">
            <option value="">All Status</option>
        @foreach (var s in Enum.GetValues(typeof(RequestStatus)))
        {
            if (ViewBag.SelectedStatus?.ToString() == s.ToString())
            {
                <option value="@s" selected>@s</option>
            }
            else
            {
                <option value="@s">@s</option>
            }
        }
    </select>
    <button type="submit" class="btn btn-primary">Filter</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
</form>
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Priority)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompletedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MachineId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Machine)
            </th>
            <th>Techncian</th>
            <tbody>

            </tbody>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                @Html.DisplayFor(model => item.Priority)
            </td>
            <td>
                    @if (item.Status == RequestStatus.Pending)
                    {
                    <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (item.Status == RequestStatus.InProgress)
                    {
                    <span class="badge bg-primary">In Progress</span>
                    }
                    else if (item.Status == RequestStatus.Completed)
                    {
                    <span class="badge bg-success">Completed</span>
                    }
                    
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(model => item.CompletedAt)
            </td>
            <td>
                @Html.DisplayFor(model => item.MachineId)
            </td>
            <td>
                    @item.Machine?.Name
            </td>
                <td>
                    @(item.Technician?.FullName ?? "ยังไม่ assign")
                </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
        @if (!Model.Any())
        {
            <tr><td colspan="9" class="text-center text-muted">ไม่พบข้อมูล</td></tr>
        }
    </tbody>
</table>

<script>
    const params = new URLSearchParams(window.location.search);
    document.querySelector('select[name="status"]').value = params.get('status') || '';
</script>