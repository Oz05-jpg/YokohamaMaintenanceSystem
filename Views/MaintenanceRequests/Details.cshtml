@model YokohamaMaintenanceSystem.Models.MaintenanceRequest
@{
    ViewData["Title"] = "Maintenance Request Details";
}

<div class="fmms-header">
    <h2>🛠️ Maintenance Request Details</h2>
    <a asp-action="Index" class="btn btn-outline-light btn-sm">← Back</a>
</div>

<div class="form-card">
    <dl class="row">
        <dt class="col-sm-3 text-muted">Title</dt>
        <dd class="col-sm-9 fw-semibold">@Model.Title</dd>

        <dt class="col-sm-3 text-muted">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3 text-muted">Priority</dt>
        <dd class="col-sm-9">@Model.Priority</dd>

        <dt class="col-sm-3 text-muted">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3 text-muted">Created</dt>
        <dd class="col-sm-9">@Model.CreatedAt</dd>

        <dt class="col-sm-3 text-muted">Completed</dt>
        <dd class="col-sm-9">@Model.CompletedAt</dd>

        <dt class="col-sm-3 text-muted">เครื่องจักร</dt>
        <dd class="col-sm-9">@Model.Machine?.Name</dd>

        <dt class="col-sm-3 text-muted">ช่างเทคนิค</dt>
        <dd class="col-sm-9">@(Model.Technician?.FullName ?? "ยังไม่ assign")</dd>
    </dl>

    <hr />

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-fmms">Edit</a>

        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            <input type="hidden" name="id" value="@Model.Id" />
            <select name="newStatus" class="form-select form-select-sm">
                <option>ระบุสถานะการทำงาน</option>
                <option value="Pending">Pending</option>
                <option value="InProgress">In Progress</option>
                <option value="Completed">Completed</option>
            </select>
            <button type="submit" class="btn btn-fmms btn-sm">Update</button>
        </form>

        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>
