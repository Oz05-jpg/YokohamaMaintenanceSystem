@model YokohamaMaintenanceSystem.Models.RequestStatusHistoryViewModel
@{
    ViewData["Title"] = "Maintenance Request Details";
}

<div class="fmms-header">
    <h2>🛠️ Maintenance Request Details</h2>
    <a asp-action="Index" class="btn btn-outline-light btn-sm">← Back</a>
</div>

<div class="form-card">
    <dl class="row">
        <dt class="col-sm-3 text-muted">Title</dt>
        <dd class="col-sm-9 fw-semibold">@Model.Request.Title</dd>

        <dt class="col-sm-3 text-muted">Description</dt>
        <dd class="col-sm-9">@Model.Request.Description</dd>

        <dt class="col-sm-3 text-muted">Priority</dt>
        <dd class="col-sm-9">@Model.Request.Priority</dd>

        <dt class="col-sm-3 text-muted">Status</dt>
        <dd class="col-sm-9">@Model.Request.Status</dd>

        <dt class="col-sm-3 text-muted">Created</dt>
        <dd class="col-sm-9">@Model.Request.CreatedAt</dd>

        <dt class="col-sm-3 text-muted">Completed</dt>
        <dd class="col-sm-9">@Model.Request.CompletedAt</dd>

        <dt class="col-sm-3 text-muted">เครื่องจักร</dt>
        <dd class="col-sm-9">@Model.Request.Machine?.Name</dd>

        <dt class="col-sm-3 text-muted">ช่างเทคนิค</dt>
        <dd class="col-sm-9">@(Model.Request.Technician?.FullName ?? "ยังไม่ assign")</dd>
    </dl>

    <hr />

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@Model.Request.Id" class="btn btn-fmms">Edit</a>

        <form asp-action="UpdateStatus" asp-route-id="@Model.Request.Id" method="post" class="d-flex gap-2">
            <input type="hidden" name="id" value="@Model.Request.Id" />
            <select name="newStatus" class="form-select form-select-sm">
                <option>ระบุสถานะการทำงาน</option>
                <option value="Pending">Pending</option>
                <option value="InProgress">In Progress</option>
                <option value="Completed">Completed</option>
            </select>
            <button type="submit" class="btn btn-fmms btn-sm">Update</button>
        </form>

        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

@* ===== ส่วนแสดงประวัติการเปลี่ยนสถานะ ===== *@
<div class="form-card mt-4">
    <h3>Request Status History</h3>
    
    @if(Model.Histories == null || !Model.Histories.Any())
    {
        <div class="alert alert-info mb-0" role="alert">
            <i class="bi bi-info-circle"></i>
            ยังไม่มีประวัติการเปลี่ยนสถานะ
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 20%;">วันเวลา</th>
                        <th style="width: 18%;">จากสถานะ</th>
                        <th style="width: 18%;">เป็นสถานะ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.Histories)
                    {
                        <tr>
                            <td>@h.ChangedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge bg-secondary">@h.OldStatus</span>
                            </td>
                            <td>
                                <span class="badge bg-success">@h.NewStatus</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>