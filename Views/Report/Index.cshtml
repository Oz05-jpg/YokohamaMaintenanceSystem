@model YokohamaMaintenanceSystem.Models.ReportViewModel

<h2>Maintenance Report</h2>

<div class="row">
    <div class="col-md-4">
        <div class="card text-bg-warning">
            <div class="card-body">
                <h5>Pending</h5>
                <p class="fs-1">@Model.PendingCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-bg-primary">
            <div class="card-body">
                <h5>In Progress</h5>
                <p class="fs-1">@Model.InProgressCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-bg-success">
            <div class="card-body">
                <h5>Completed</h5>
                <p class="fs-1">@Model.CompletedCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <a asp-action="Export" asp-controller="Report"
           asp-route-format="excel" class="btn btn-success">
            Export Excel
        </a>
    </div>

    <div class="col-md-4">
        <a asp-action="Export" asp-controller="Report"
           asp-route-format="csv" class="btn btn-primary">
            Export CSV
        </a>
    </div>

    <div class="col-md-4">
        <a asp-action="Export" asp-controller="Report"
           asp-route-format="pdf" class="btn btn-danger">
            Export PDF
        </a>
    </div>

</div>

@if (Model.PendingCount == 0 && Model.InProgressCount == 0 && Model.CompletedCount == 0)
{
    <p>No maintenance requests found.</p>
}