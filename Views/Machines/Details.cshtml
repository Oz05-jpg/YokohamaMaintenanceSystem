@model YokohamaMaintenanceSystem.Models.Machine
@{
    ViewData["Title"] = "Machine Details";
}

<div class="fmms-header">
    <h2>🔧 Machine Details</h2>
    <a asp-action="Index" class="btn btn-outline-light btn-sm">← Back</a>
</div>

<div class="form-card">
    <dl class="row">
        <dt class="col-sm-4 text-muted">ชื่อเครื่องจักร</dt>
        <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

        <dt class="col-sm-4 text-muted">สถานที่</dt>
        <dd class="col-sm-8">@Model.Location</dd>

        <dt class="col-sm-4 text-muted">สถานะ</dt>
        <dd class="col-sm-8">@Model.Status</dd>

        <dt class="col-sm-4 text-muted">วันที่ติดตั้ง</dt>
        <dd class="col-sm-8">@Model.InstalledDate</dd>
    </dl>

    <hr />

    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-fmms">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>
