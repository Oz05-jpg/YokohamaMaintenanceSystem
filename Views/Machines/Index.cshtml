@model IEnumerable<YokohamaMaintenanceSystem.Models.Machine>

@{
    ViewData["Title"] = "Machines";
}
<div class="yms-header">
    <h2> 🔧 เครื่องจักร Machines Management </h2>
    <a asp-action="Create" class="btn btn-yms mt-2">+ เพิ่มเครื่องจักร</a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <p style="font-size:1.1rem">ไม่พบเครื่องจักร</p>
        <a asp-action="Create" class="btn btn-yms mt-2">+ เพิ่มเครื่องจักร</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table yms-table">
            <thead>
                <tr>
                    <th>ชื่อเครื่องจักร</th>
                    <th>สถานที่</th>
                    <th>สถานะ</th>
                    <th>วันที่ติดตั้ง</th>
                    <th style="width:140px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Location</td>
                        <td>@item.Status</td>
                        <td>@item.InstalledDate</td>
                        <td class="d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}