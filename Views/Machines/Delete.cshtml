@model YokohamaMaintenanceSystem.Models.Machine
@{
    ViewData["Title"] = "Delete Machine";
}

<div class="fmms-header">
    <h2>🗑️ Delete Machine</h2>
</div>

<div class="delete-warning mb-4">
    <strong>ยืนยันการลบ?</strong>
    <p class="mb-0 mt-1">เครื่องจักร: <strong>@Model.Name</strong> จะถูกลบออกจากระบบถาวร</p>
</div>

<dl class="row mb-4">
    <dt class="col-sm-3">สถานที่</dt>
    <dd class="col-sm-9">@Model.Location</dd>
    <dt class="col-sm-3">สถานะ</dt>
    <dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">วันที่ติดตั้ง</dt>
    <dd class="col-sm-9">@Model.InstalledDate</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger px-4">ลบ</button>
        <a asp-action="Index" class="btn btn-outline-secondary">ยกเลิก</a>
    </div>
</form>
